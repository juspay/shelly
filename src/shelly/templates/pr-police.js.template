#!/usr/bin/env node

/**
 * PR Police - Automated PR Review and Validation
 *
 * Reviews PRs for:
 * - Code quality issues
 * - Security vulnerabilities
 * - Best practices violations
 * - Breaking changes
 * - Missing tests
 *
 * Usage:
 *   node scripts/pr-police.js [pr-id]
 *   pnpm run review [pr-id]
 *
 * Environment Variables Required:
 *   GOOGLE_AI_API_KEY - Google AI API key for NeuroLink
 *   BITBUCKET_TOKEN - Bitbucket personal access token
 *   BITBUCKET_USERNAME - Your Bitbucket username
 *   BITBUCKET_BASE_URL - Bitbucket server base URL
 */

import { config } from 'dotenv';
import { NeuroLink } from '@juspay/neurolink';
import { BitbucketMCPServer } from '@nexus2520/bitbucket-mcp-server';

// Load environment variables from .env file
config();

// Configuration
const WORKSPACE = '{{workspaceName}}'; // e.g., 'BZ' or 'breeze'
const REPO_SLUG = '{{repoSlug}}'; // e.g., 'vayu', 'nimble'

async function reviewPR(prId) {
  try {
    console.log(`🔍 Reviewing PR #${prId}...`);

    // Initialize NeuroLink (AI orchestration)
    const neurolink = new NeuroLink({
      apiKey: process.env.GOOGLE_AI_API_KEY,
      model: 'gemini-2.5-pro',
    });

    // Initialize Bitbucket MCP handlers
    const bitbucket = new BitbucketMCPServer({
      token: process.env.BITBUCKET_TOKEN,
      username: process.env.BITBUCKET_USERNAME,
      baseUrl: process.env.BITBUCKET_BASE_URL,
    });

    // Step 1: Fetch PR data
    console.log('📥 Fetching PR data...');
    const pr = await bitbucket.callTool('get_pull_request', {
      workspace: WORKSPACE,
      repoSlug: REPO_SLUG,
      prId: prId,
    });

    // Step 2: Get code changes
    console.log('📊 Analyzing code changes...');
    const diff = await bitbucket.callTool('get_pull_request_diff', {
      workspace: WORKSPACE,
      repoSlug: REPO_SLUG,
      prId: prId,
    });

    // Step 3: Get changed files
    const files = await bitbucket.callTool('list_pull_request_files', {
      workspace: WORKSPACE,
      repoSlug: REPO_SLUG,
      prId: prId,
    });

    // Step 4: AI reviews the changes
    console.log('🧠 AI analyzing code quality...');
    const prompt = `
You are an expert code reviewer. Review this Pull Request for potential issues.

**PR Information:**
- Title: ${pr.title}
- Author: ${pr.author.displayName}
- Files Changed: ${files.length}

**Code Changes:**
\`\`\`diff
${diff}
\`\`\`

**Review Checklist:**

1. **Security** - Check for:
   - SQL injection vulnerabilities
   - XSS vulnerabilities
   - Hardcoded credentials or secrets
   - Unsafe input handling

2. **Code Quality** - Check for:
   - Code duplication
   - Overly complex functions
   - Missing error handling
   - Poor naming conventions

3. **Best Practices** - Check for:
   - Missing tests for new features
   - Breaking API changes
   - Missing documentation
   - Performance concerns

4. **Juspay Standards** - Check for:
   - Proper use of @juspay packages
   - Adherence to coding standards
   - Proper logging and monitoring

**Output Format:**

## Review Summary
[Overall assessment: APPROVED / NEEDS CHANGES / BLOCKED]

## Issues Found
### 🔴 Critical (Must Fix)
- [List critical issues that must be fixed]

### 🟡 Warnings (Should Fix)
- [List issues that should be addressed]

### 🟢 Suggestions (Nice to Have)
- [List optional improvements]

## Positive Notes
- [Highlight good practices used]

If no issues found, say "No issues found - looks good! ✅"
`;

    const response = await neurolink.chat(prompt);
    const review = response.content;

    // Step 5: Post review as comment
    console.log('💬 Posting review comment...');
    await bitbucket.callTool('add_pull_request_comment', {
      workspace: WORKSPACE,
      repoSlug: REPO_SLUG,
      prId: prId,
      text: `## 🤖 Automated PR Review\n\n${review}\n\n---\n*Generated by PR Police*`,
    });

    console.log('✅ PR review completed!');
    console.log('\n' + '='.repeat(80));
    console.log(review);
    console.log('='.repeat(80) + '\n');

    // Exit with appropriate code based on assessment, not section headings
    // Look for the assessment line in Review Summary section
    if (review.includes('BLOCKED')) {
      console.log('🚫 PR blocked - critical issues must be fixed');
      process.exit(1);
    } else if (review.includes('NEEDS CHANGES')) {
      console.log('⚠️  PR needs changes before approval');
      process.exit(1);
    } else if (review.includes('APPROVED') || review.includes('No issues found')) {
      console.log('✅ PR looks good!');
      process.exit(0);
    } else {
      // Fallback: check if there are actual findings under the headings
      // Look for list items after the critical/warning headings
      const hasCriticalItems = /### 🔴 Critical.*\n-\s+\[(?!List critical|None|No critical)/s.test(review);
      const hasWarningItems = /### 🟡 Warnings.*\n-\s+\[(?!List issues|None|No warnings)/s.test(review);

      if (hasCriticalItems) {
        console.log('⚠️  Critical issues found - PR needs changes');
        process.exit(1);
      } else if (hasWarningItems) {
        console.log('⚠️  Warnings found - consider addressing them');
        process.exit(0);
      } else {
        console.log('✅ No issues found');
        process.exit(0);
      }
    }

  } catch (error) {
    console.error('❌ Error reviewing PR:', error.message);
    if (process.env.DEBUG) {
      console.error(error.stack);
    }
    process.exit(1);
  }
}

// Main execution
const prId = process.argv[2];

if (!prId) {
  console.error('❌ Usage: node pr-police.js <pr-id>');
  console.error('   Example: node pr-police.js 123');
  process.exit(1);
}

// Check required environment variables
const requiredEnvVars = [
  'GOOGLE_AI_API_KEY',
  'BITBUCKET_TOKEN',
  'BITBUCKET_USERNAME',
  'BITBUCKET_BASE_URL',
];

const missingVars = requiredEnvVars.filter((v) => !process.env[v]);
if (missingVars.length > 0) {
  console.error('❌ Missing required environment variables:');
  missingVars.forEach((v) => console.error(`   - ${v}`));
  console.error('\n💡 Set them in your .env file or export them in your shell');
  process.exit(1);
}

reviewPR(prId);
