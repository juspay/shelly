// Jenkinsfile for {{projectName}} - Juspay Breeze Standard
// Auto-generated by Shelly - Enterprise CI/CD Pipeline
// Based on production Breeze workflows with AI automation
// Repository: {{workspace}}/{{repoName}}

pipeline {
  agent {
    label 'vayu'  // Juspay Jenkins node for Breeze projects
  }

  parameters {
    booleanParam(
      defaultValue: true,
      description: 'Check for [skip ci] tag in commit message',
      name: 'continueBuild'
    )
    booleanParam(
      defaultValue: true,
      description: 'Enable AI Review for this build',
      name: 'isAIReviewNeeded'
    )
    booleanParam(
      defaultValue: true,
      description: 'Enable AI Description Enhancement for this build',
      name: 'isAIDescriptionNeeded'
    )
  }

  environment {
    // Project Configuration
    DEP_LABEL = "${sh(script: 'echo -n $JOB_BASE_NAME | tr \'/\' \'_\' | tr \'%2F\' \'_\' ', returnStdout: true)}"
    PROJECT_NAME = "{{projectName}}"
    GIT_URL = "{{gitUrl}}"  // e.g., bitbucket.juspay.net/scm/bz/your-project.git
    WORKSPACE_NAME = "{{workspace}}"  // e.g., BZ (Breeze)

    // PNPM Configuration
    PNPM_STORE_DIR = "${JENKINS_HOME}/.pnpm-store"

    // Node.js Configuration
    NODE_OPTIONS = '--max-old-space-size=4096'

    // Juspay Standard Credentials (configure these in Jenkins)
    // These should be set up once in Jenkins Credentials Manager
    AP_BETA = credentials('INFRA_SWITCH_SECRET')
    // AP_RELEASE = credentials('ap-release')  // Uncomment after configuration
    JIRA = credentials('c3e1fb65-7cf9-4fbd-9a30-93201908e0a2')
    BITBUCKET = credentials('d491690d-46d9-4ecb-8b6f-fa6781afd9d9')
    TITAN = credentials('titan-hosted-bitbucket')

    // Git Configuration for Titan bot
    GIT_AUTHOR_NAME = "Titan"
    GIT_AUTHOR_EMAIL = "titan.a@juspay.in"
    GIT_COMMITTER_NAME = "Titan"
    GIT_COMMITTER_EMAIL = "titan.a@juspay.in"
    GIT_USERNAME = "Titan"
    GIT_EMAIL = "titan.a@juspay.in"

    // BitBucket Configuration
    BITBUCKET_USERNAME = "titan.a@juspay.in"
    BITBUCKET_TOKEN = credentials("titan-bitbucket-bearer-token")

    // AWS Configuration (customize for your project)
    AWS_REGION = "ap-south-1"
    S3_BUCKET = "{{s3Bucket}}"  // e.g., atoms-sdk
    S3_AWS_ROLE = "arn:aws:iam::671255721112:role/JenkinsBreeze"
    S3_BASE_PATH = "{{projectName}}"

    // GCP Configuration (customize for your project)
    GCP_BETA_CREDENTIALS = credentials('breeze-uat-secrets')
    GCP_RELEASE_CREDENTIALS = credentials('super-checkout-prod-sa')
    GCP_BETA_PROJECT_ID = "breeze-uat-453414"
    GCP_RELEASE_PROJECT_ID = "super-checkout-prod"
    GCP_REGION = "asia-south1"
    GCP_ARTIFACT_REPO = "{{projectName}}"
    GCS_BETA_BUCKET = "atoms-sdk"
    GCS_RELEASE_BUCKET = "atoms_sdk"
    GCS_BASE_PATH = "{{projectName}}"
    GCP_BETA_ASSETS_BASE_URL = "https://sdk.beta.breezesdk.store"
    GCP_RELEASE_ASSETS_BASE_URL = "https://sdk.breezesdk.store"

    // Product/Service Labels
    PRODUCT = "BREEZE"
    SERVICE = "BREEZE-APP"

    // AI Configuration (Vertex AI / Gemini)
    GOOGLE_AI_API_KEY = credentials('GEMINI_API_KEY')
    GOOGLE_APPLICATION_CREDENTIALS = credentials('VERTEX_COUNT')
    GOOGLE_VERTEX_PROJECT = "dev-ai-eta"
    VERTEX_MODEL_ID = "gemini-2.5-pro"
    GOOGLE_VERTEX_LOCATION = "us-central1"
  }

  stages {
    stage('Checkout') {
      steps {
        script {
          def startTime = System.currentTimeMillis()

          // Check for [skip ci] or [ci skip] tags
          if (sh(script: "git log -1 --pretty=%B | grep -F -ie '[skip ci]' -e '[ci skip]'", returnStatus: true) == 0) {
            env.continueBuild = "false"
            echo "⏭️ [skip ci] tag detected. Skipping build."
          }

          // Check for [auto-deployment] tag
          if (sh(script: "git log -1 --pretty=%B | grep -F -i '[auto-deployment]'", returnStatus: true) == 0) {
            env.autoDeployment = "true"
            echo "🚀 [auto-deployment] tag detected! Will trigger beta deployment after tests pass."
          } else {
            env.autoDeployment = "false"
          }

          def endTime = System.currentTimeMillis()
          echo "⏱️ Checkout Time: ${(endTime - startTime) / 1000} seconds"
        }
      }
    }

    stage('Build & Test App') {
      when {
        allOf {
          anyOf {
            branch '{{workspace}}-*'           // e.g., BZ-1234
            branch 'bugfix/{{workspace}}-*'    // e.g., bugfix/BZ-1234
            branch 'feature/{{workspace}}-*'   // e.g., feature/BZ-1234
            branch 'hotfix/{{workspace}}-*'    // e.g., hotfix/BZ-1234
          }
          expression {
            return env.continueBuild != "false"
          }
        }
      }
      steps {
        script {
          echo '🏗️ Building and testing the app'
          def timeData = []
          def overallStartTime = System.currentTimeMillis()

          // Switch to beta branch for comparison
          def startTime = System.currentTimeMillis()
          sh "git checkout beta"
          def endTime = System.currentTimeMillis()
          timeData.add(["Checkout beta", (endTime - startTime) / 1000])

          // Switch back to current branch
          startTime = System.currentTimeMillis()
          sh "git checkout ${GIT_BRANCH}"
          endTime = System.currentTimeMillis()
          timeData.add(["Checkout branch", (endTime - startTime) / 1000])

          // Enforce single commit policy
          startTime = System.currentTimeMillis()
          env.TOTALCOMMITS = sh(
            returnStdout: true,
            script: "git rev-list --count beta..HEAD | tr -d '\"' | tr -d '\\n'"
          ).trim()
          endTime = System.currentTimeMillis()
          echo "📊 Total commits on this branch: ${env.TOTALCOMMITS}"
          timeData.add(["Count commits", (endTime - startTime) / 1000])

          if (env.TOTALCOMMITS != "1") {
            currentBuild.result = 'ABORTED'
            error '❌ Aborting: Branch contains multiple commits! Please squash into a single commit.'
          }

          // Install dependencies with PNPM
          startTime = System.currentTimeMillis()
          sh "pnpm config set registry https://registry.npmmirror.com"
          sh "pnpm install"
          endTime = System.currentTimeMillis()
          timeData.add(["Install dependencies", (endTime - startTime) / 1000])

          // Run linting
          startTime = System.currentTimeMillis()
          sh "pnpm run lint"
          endTime = System.currentTimeMillis()
          timeData.add(["Run lint", (endTime - startTime) / 1000])

          // Run type checking (if exists)
          startTime = System.currentTimeMillis()
          sh "pnpm run check || true"
          endTime = System.currentTimeMillis()
          timeData.add(["Run type check", (endTime - startTime) / 1000])

          // Setup environment for beta
          startTime = System.currentTimeMillis()
          echo "⚙️ Setting up environment for beta..."
          // Add your environment setup script here
          // sh "node scripts/setup-env.js beta"
          endTime = System.currentTimeMillis()
          timeData.add(["Setup environment", (endTime - startTime) / 1000])

          // Build the project
          startTime = System.currentTimeMillis()
          sh "pnpm run build"
          endTime = System.currentTimeMillis()
          timeData.add(["Build", (endTime - startTime) / 1000])

          // Run tests (if you have Playwright tests)
          echo "🧪 Running automated test cases..."
          try {
            sh "npx playwright --version"

            startTime = System.currentTimeMillis()
            sh "pnpm exec playwright install"
            endTime = System.currentTimeMillis()
            timeData.add(["Install Playwright browsers", (endTime - startTime) / 1000])

            startTime = System.currentTimeMillis()
            sh "CI=true TEST_ENV=local pnpm run test || true"
            endTime = System.currentTimeMillis()
            timeData.add(["Run tests", (endTime - startTime) / 1000])

            echo "✅ Tests completed!"
          } catch (e) {
            echo "⚠️ Playwright not configured or tests failed: ${e.message}"
          } finally {
            // Archive test results
            try {
              archiveArtifacts artifacts: 'test-results/**/*', fingerprint: true, allowEmptyArchive: true
            } catch (archiveError) {
              echo "ℹ️ No test artifacts to archive"
            }
          }

          // Validate commit message format
          startTime = System.currentTimeMillis()
          echo "📝 Validating commit message format..."
          echo "Expected: BZ-1234: (type): Short description"
          sh "git log -1 --oneline --format=%s | npx --no -- commitlint"
          endTime = System.currentTimeMillis()
          timeData.add(["Validate commit message", (endTime - startTime) / 1000])

          // Build Docker image if Dockerfile changed
          def dockerfileChange = sh(
            script: "git diff --name-only beta..HEAD | grep -i 'Dockerfile' || true",
            returnStdout: true
          )
          if (dockerfileChange.length() > 0) {
            startTime = System.currentTimeMillis()
            echo "🐳 Dockerfile changed, building Docker image..."
            // Add your Docker build logic here
            // sh "docker build -t ${PROJECT_NAME}:${GIT_COMMIT} ."
            endTime = System.currentTimeMillis()
            timeData.add(["Docker image build", (endTime - startTime) / 1000])
          } else {
            echo "ℹ️ No Dockerfile changes detected. Skipping Docker build."
          }

          def overallEndTime = System.currentTimeMillis()
          echo "⏱️ Total Build & Test time: ${(overallEndTime - overallStartTime) / 1000} seconds"

          // Print timing summary
          echo "\n📊 Time Data Summary:"
          echo "┌─────────────────────────────┬─────────────────┐"
          echo "│ Task                        │ Time (seconds)  │"
          echo "├─────────────────────────────┼─────────────────┤"
          timeData.each { data ->
            echo "│ ${data[0].padRight(27, ' ')} │ ${data[1].toString().padLeft(15, ' ')} │"
          }
          echo "└─────────────────────────────┴─────────────────┘"
        }
      }
    }

    stage("AI Automation") {
      when {
        expression { shouldRunAIReview() }
      }
      parallel {
        stage("Auto Description") {
          when {
            expression { params.isAIDescriptionNeeded }
          }
          steps {
            script {
              env.FAILED_STAGE = env.STAGE_NAME
              catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                echo "🤖 Running AI-powered description enhancement..."
                sh "pnpm run pr:describe ${env.CHANGE_ID} || true"
              }
            }
          }
        }

        stage("Auto Review") {
          when {
            expression { params.isAIReviewNeeded }
          }
          steps {
            script {
              env.FAILED_STAGE = env.STAGE_NAME
              catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                echo "🤖 Running AI-powered code review..."
                sh "pnpm run pr:review ${env.CHANGE_ID} || true"
              }
            }
          }
        }
      }
    }

    stage('Deploy to Beta') {
      when {
        allOf {
          anyOf {
            branch 'beta'
            expression { return env.autoDeployment == "true" }
          }
          expression {
            return env.continueBuild != "false"
          }
        }
      }
      steps {
        script {
          echo "🚀 Deploying to Beta environment..."
          def timeData = []
          def overallStartTime = System.currentTimeMillis()

          def startTime = System.currentTimeMillis()
          sh "pnpm config set registry https://registry.npmmirror.com"
          sh "pnpm install"
          def endTime = System.currentTimeMillis()
          timeData.add(["Install dependencies", (endTime - startTime) / 1000])

          startTime = System.currentTimeMillis()
          echo "⚙️ Setting up beta environment..."
          // Add your beta environment setup here
          endTime = System.currentTimeMillis()
          timeData.add(["Setup beta environment", (endTime - startTime) / 1000])

          // Add your deployment logic here
          // This could include:
          // - Building production assets
          // - Uploading to S3/GCS
          // - Invalidating CDN cache
          // - Notifying deployment systems

          def overallEndTime = System.currentTimeMillis()
          echo "⏱️ Total Beta Deploy time: ${(overallEndTime - overallStartTime) / 1000} seconds"

          echo "\n📊 Beta Deployment Summary:"
          echo "┌─────────────────────────────┬─────────────────┐"
          echo "│ Task                        │ Time (seconds)  │"
          echo "├─────────────────────────────┼─────────────────┤"
          timeData.each { data ->
            echo "│ ${data[0].padRight(27, ' ')} │ ${data[1].toString().padLeft(15, ' ')} │"
          }
          echo "└─────────────────────────────┴─────────────────┘"
        }
      }
      post {
        always {
          script {
            try {
              jiraSendDeploymentInfo(
                environmentId: 'beta',
                environmentName: 'beta',
                environmentType: 'staging',
                site: 'juspay.atlassian.net'
              )
            } catch (ex) {
              echo "⚠️ Jira deployment notification failed: ${ex}"
            }
          }
        }
      }
    }

    stage('Deploy to Release') {
      when {
        allOf {
          branch 'release'
          expression {
            return env.continueBuild != "false"
          }
        }
      }
      steps {
        script {
          echo "🚀 Deploying to Production (Release) environment..."

          sh "pnpm config set registry https://registry.npmmirror.com"
          sh "pnpm install"

          echo "⚙️ Setting up release environment..."
          // Add your release environment setup here

          // Add your production deployment logic here
        }
      }
      post {
        always {
          script {
            try {
              jiraSendDeploymentInfo(
                environmentId: 'release',
                environmentName: 'release',
                environmentType: 'production',
                site: 'juspay.atlassian.net'
              )
            } catch (ex) {
              echo "⚠️ Jira deployment notification failed: ${ex}"
            }
          }
        }
      }
    }
  }

  post {
    always {
      script {
        echo "🧹 Cleaning up workspace..."
        cleanWs(
          deleteDirs: true,
          patterns: [
            [pattern: 'node_modules', type: 'INCLUDE'],
            [pattern: '.pnpm-store', type: 'INCLUDE'],
            [pattern: 'dist', type: 'INCLUDE'],
            [pattern: 'build', type: 'INCLUDE']
          ]
        )
      }
    }

    success {
      echo "✅ Pipeline completed successfully!"
      // Add success notifications (Slack, email, etc.)
      // slackSend(color: 'good', message: "✅ Build SUCCESS: ${env.JOB_NAME} #${env.BUILD_NUMBER}")
    }

    failure {
      echo "❌ Pipeline failed!"
      // Add failure notifications
      // slackSend(color: 'danger', message: "❌ Build FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER}")
    }

    unstable {
      echo "⚠️ Pipeline is unstable"
      // Add unstable notifications
      // slackSend(color: 'warning', message: "⚠️ Build UNSTABLE: ${env.JOB_NAME} #${env.BUILD_NUMBER}")
    }
  }
}

// Helper function to determine if AI review should run
def shouldRunAIReview() {
  def branchName = env.BRANCH_NAME
  // Only run AI automation on PR builds (not direct branch pushes)
  // and exclude beta/release branches
  if (!env.CHANGE_ID) {
    echo "⏭️  Skipping AI review: Not a PR build (no CHANGE_ID)"
    return false
  }
  if (branchName == 'beta' || branchName == 'release') {
    echo "⏭️  Skipping AI review: beta/release branches excluded"
    return false
  }
  return true
}
