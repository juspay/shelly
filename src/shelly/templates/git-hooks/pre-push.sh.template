#!/usr/bin/env bash

set -e

BRANCH_NAME=$(git branch | grep '*' | sed 's/* //')

# Skip checks in CI/deployment pipelines
if [[ $BRANCH_NAME != *"no branch"* ]] && [[ "$EXECUTION_MODE" != "BREEZE_DEPLOYMENT" ]]; then
  echo "🔍 Running pre-push checks..."
  {{PACKAGE_MANAGER}} run build
fi

finish() {
  result=$?
  exit ${result}
}
trap finish EXIT ERR
