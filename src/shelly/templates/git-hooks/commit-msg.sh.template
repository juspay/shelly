#!/usr/bin/env bash

set -e

# Validate commit message follows Juspay convention:
# {{TICKET_PREFIX}}-<number>: type(scope): description
# Example: BZ-1234: feat(auth): add OAuth2 login

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

PATTERN="^{{TICKET_PREFIX}}-[0-9]+: (feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?: .+"

if ! echo "$COMMIT_MSG" | grep -qE "$PATTERN"; then
  echo ""
  echo "❌ Commit message does not follow the required format."
  echo ""
  echo "   Expected: {{TICKET_PREFIX}}-<number>: type(scope): description"
  echo "   Example:  {{TICKET_PREFIX}}-1234: feat(auth): add OAuth2 login"
  echo ""
  echo "   Valid types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
  echo ""
  echo "   Your message: $COMMIT_MSG"
  echo ""
  exit 1
fi

finish() {
  result=$?
  exit ${result}
}
trap finish EXIT ERR
