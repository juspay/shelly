#!/usr/bin/env bash

set -e

BRANCH_NAME=$(git branch | grep '*' | sed 's/* //')

# Skip checks in CI/deployment pipelines
if [[ $BRANCH_NAME != *"no branch"* ]] && [[ "$EXECUTION_MODE" != "BREEZE_DEPLOYMENT" ]] && [[ "$EXECUTION_MODE" != "HYPER_DEPLOYMENT" ]]; then
  {{PACKAGE_MANAGER}} run lint
  {{PACKAGE_MANAGER}} run format

  # Re-add any files that were auto-formatted
  git add $(git diff --name-only --cached --diff-filter=d | xargs)
fi

finish() {
  result=$?
  exit ${result}
}
trap finish EXIT ERR
