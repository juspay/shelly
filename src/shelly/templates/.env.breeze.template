# Breeze AI & MCP Configuration
# Required for PR automation and AI-powered features

# ==========================================
# Google AI (NeuroLink) Configuration
# ==========================================
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# ==========================================
# Bitbucket Configuration
# ==========================================
# Personal Access Token - Create at:
# https://bitbucket.juspay.net/profile/personal-access-tokens
# Required permissions: Repository Read, Repository Write
BITBUCKET_TOKEN=your_bitbucket_personal_access_token

# Your Bitbucket username (usually your email)
BITBUCKET_USERNAME=your.email@juspay.in

# Bitbucket server base URL
BITBUCKET_BASE_URL=https://bitbucket.juspay.net

# ==========================================
# Optional: Debug Mode
# ==========================================
# Set to 'true' to enable detailed logging
DEBUG=false
